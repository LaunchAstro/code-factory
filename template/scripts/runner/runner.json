{
  "repository": "<owner>/<repository>",
  "launcher": {
    "template": "$HOME/bin/claude-<seat>",
    "model": "claude-opus-5"
  },
  "reviewOfRecord": {
    "reviewer": "Sol (Codex)",
    "model": "gpt-5.6-sol",
    "command": "codex exec --dangerously-bypass-approvals-and-sandbox"
  },
  "copilotLogin": "copilot-pull-request-reviewer[bot]",
  "minutes": {
    "plan": 45,
    "build": 75,
    "review": 15,
    "fix": 45
  },
  "perPullRequest": {
    "opus": 2,
    "sol": 2,
    "copilot": 0
  },
  "perRun": {
    "opus": 20,
    "sol": 6,
    "copilot": 0
  },
  "heldLabel": "held",
  "statusPath": "../<orchestration-root>/.local/lanes/loop/STATUS.md",
  "budgetPath": "../<orchestration-root>/.local/lanes/loop/runner-budget.json"
}
