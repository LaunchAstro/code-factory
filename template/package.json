{
  "name": "@your-scope/your-product",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pre-alpha organisational system foundation. Product implementation is pending.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node scripts/build.mjs",
    "brand:check": "node scripts/product-name.mjs --check",
    "brand:cases": "node --test tests/branding/product-name-cases.mjs",
    "runner:cases": "bash tests/ci/runner-cases.sh",
    "gate:selftest": "python3 scripts/gate/sweep.py --self-test",
    "gate": "python3 scripts/gate/sweep.py",
    "gate:cases": "bash tests/gate/gate-cases.sh",
    "gate:hooks": "bash tests/gate/hook-exit-cases.sh",
    "commits:cases": "bash tests/ci/commit-range-cases.sh",
    "size:cases": "bash tests/ci/pr-size-cases.sh",
    "review:cases": "bash tests/ci/review-evidence-cases.sh",
    "acceptance": "node scripts/acceptance-check.mjs",
    "acceptance:cases": "bash tests/ci/acceptance-cases.sh",
    "acceptance:base:cases": "bash tests/ci/acceptance-base-config-cases.sh",
    "plan:check": "node scripts/plan-check.mjs tests/acceptance/10-label-trigger",
    "plan:check:cases": "node --test tests/ci/plan-check-cases.mjs",
    "fence:closer:cases": "node --test tests/ci/fence-closer-cases.mjs",
    "surface": "node scripts/sensitive-surface.mjs",
    "surface:cases": "node --test tests/ci/sensitive-paths-cases.mjs",
    "release:ref:cases": "node --test tests/ci/release-ref-cases.mjs",
    "session:cases": "bash tests/agents/session-check-cases.sh",
    "text:policy": "node scripts/text-file-policy.mjs",
    "text:policy:cases": "node --test tests/ci/text-file-policy-cases.mjs",
    "presets": "node scripts/preset-boundary-check.mjs",
    "presets:cases": "node --test tests/ci/preset-boundary-cases.mjs",
    "receipt": "node scripts/publication-receipt.mjs",
    "pins": "node --test tests/ci/pins-check-cases.mjs && node scripts/pins-check.mjs",
    "jobs:timeouts": "node scripts/job-timeout-check.mjs",
    "jobs:timeouts:cases": "node --test tests/ci/job-timeout-cases.mjs",
    "skills:refs": "node --test tests/ci/skill-refs-cases.mjs && node scripts/skill-refs-check.mjs",
    "docs:links": "node scripts/doc-links-check.mjs",
    "docs:links:cases": "node --test tests/ci/doc-links-cases.mjs",
    "adr:index": "node scripts/adr-index-check.mjs",
    "adr:index:cases": "node --test tests/ci/adr-index-cases.mjs",
    "inventory": "node scripts/inventory.mjs --write",
    "inventory:fresh": "node scripts/inventory.mjs --check",
    "merge:policy": "node --test tests/ci/merge-policy-cases.mjs && node scripts/merge-policy-check.mjs",
    "node:policy": "node scripts/node-policy-check.mjs",
    "node:policy:cases": "node --test tests/ci/node-policy-cases.mjs",
    "gate:range": "python3 scripts/gate/sweep.py --range",
    "gate:literal": "python3 scripts/gate/sweep.py --literal",
    "licences": "node scripts/licences/check.mjs",
    "licences:cases": "bash tests/licences/licence-cases.sh",
    "check": "node scripts/check.mjs",
    "main:module:cases": "node --test tests/ci/main-module-cases.mjs",
    "check:cases": "node --test 'tests/ci/check-runner*-cases.mjs'",
    "prepare": "husky",
    "provenance:cases": "node --test tests/ci/provenance-cases.mjs",
    "candidate:cases": "node --test tests/ci/candidate-cases.mjs",
    "changed-files:cases": "node --test tests/ci/changed-files-cases.mjs",
    "check:contexts:cases": "node --test tests/ci/check-context-manifest-cases.mjs",
    "check:contexts": "node scripts/required-contexts-check.mjs .github/required-contexts.json .github/workflows/review-evidence.yml",
    "check:steps": "node scripts/check-step-refs.mjs",
    "dup:check": "node --test tests/ci/dup-check-cases.mjs && node scripts/dup-check.mjs",
    "deps:check": "node --test tests/ci/deps-check-cases.mjs && node scripts/deps-check.mjs",
    "check:steps:cases": "node --test tests/ci/check-step-refs-cases.mjs",
    "candidate:snapshot": "node scripts/candidate-snapshot.mjs",
    "public:content": "node scripts/public-content-check.mjs",
    "public:history:cases": "node --test tests/ci/public-history-cases.mjs",
    "spdx": "node scripts/spdx-check.mjs",
    "spdx:cases": "node --test tests/licences/spdx-cases.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "24.13.3",
    "husky": "9.1.7",
    "lint-staged": "17.5.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "oxlint",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
